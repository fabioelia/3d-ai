{
  "name": "caliper",
  "version": "1.0.0",
  "description": "Browser CAD for 3D-printable parts, with a Claude assistant",
  "scripts": {
    "test": "node scripts/test-kernel.mjs && node scripts/test-import.mjs",
    "dev": "node scripts/prepare-kernel.mjs && vite",
    "preview": "vite preview",
    "artifact": "npm run bundle && node scripts/make-artifact.mjs",
    "test:e2e": "node scripts/e2e.cjs && node scripts/e2e-assistant.cjs",
    "deploy": "npm run bundle && node scripts/deploy-pages.mjs",
    "bridge": "node bridge/server.mjs --http",
    "test:bridge": "node scripts/e2e-bridge.mjs",
    "bundle": "node scripts/prepare-kernel.mjs && vite build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "manifold-3d": "^3.5.4",
    "replicad": "^1.2.1",
    "replicad-opencascadejs": "^1.2.1",
    "three": "^0.187.0",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "type": "module",
  "bin": {
    "caliper-mcp": "bridge/server.mjs"
  },
  "files": [
    "bridge/",
    "src/agent/catalog.js",
    "src/guide.js",
    "dist/"
  ],
  "engines": {
    "node": ">=20"
  }
}
